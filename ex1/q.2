#include <stdio.h>

int main () {
    
    int num = 12345;
    int sum = 0;
    int firstDigit,lastDigit;
    lastDigit = num % 10;
    
    while (num >= 10) {
        
        num /= 10;
        
    }
    
    firstDigit = num;
    
    sum = firstDigit+lastDigit;
    printf("%d\n",sum);
    
    return 0;
}
