#include <stdio.h>

int main () {
    
    int i = 1899;
    int price = 0;
    
    if (i <= 0) {
        
        printf("無效輸入\n");
        
        return 0;
        
    } else if (i >0 && i <= 1500) {
        
        price = 70;
        
    } else {
        
       if (i % 100 == 0) {
           
           price = (i - 1500) / 10 + 70;
           
       } else {
           
           price = ( (i - 1500 ) / 100 + 1) * 10 + 70;
           
       }
        
    }
    
    printf ("%d\n",price);
    return 0;
    
}
